#!/usr/bin/env python3

"""
This code generates an input file 'pn.in' for Simphony.

Two sources are supported:

  1) QuantumESPRESSO: the 'name.dyn{1,2,...}' files of a ph.x run, read with SSCHA's CellConstructor.
         createSimphonyInput PathTo/name.dyn N_irr_q

  2) Phonopy (e.g. VASP+phonopy): the primitive cell is read from phonopy.yaml, and the
     Born charges / dielectric tensor (if any) from BORN.
         createSimphonyInput PathTo/phonopy.yaml [BORN|-] [prefix]

     BORN '-' (or omitted): phonopy's defaults are used (NAC parameters stored in the yaml, or a
     BORN file in the current directory); if none is found, LOTO_correction = F.
     prefix (default: yaml file name without extension) must match the one used in PHONOPY2TBDAT,
     so that Hrfile = 'prefix_phononTB_hr.dat'.

     NOTE: PHONOPY2TBDAT builds the TB model in the phonopy *unit* cell. Both are only
     consistent if the unit cell is the primitive cell (same atoms, same order).
"""


from datetime import datetime
import os
import numpy as np
import sys
import seekpath as sk


def read_qe(dynprefix, nqirrs):
    """Structure, masses (amu), Born charges and dielectric tensor from QE .dyn files."""
    import cellconstructor as CC
    import cellconstructor.Phonons
    from cellconstructor.Units import MASS_RY_TO_UMA

    dyn = CC.Phonons.Phonons()
    dyn.LoadFromQE(fildyn_prefix=dynprefix, nqirr=nqirrs)

    cell = dyn.structure.unit_cell
    return dict(prefix=dynprefix.split('.dyn')[0],
                cell=cell,
                positions=np.round(CC.Methods.covariant_coordinates(cell, dyn.structure.coords), 8),
                numbers=dyn.structure.get_ityp(),
                labels=dyn.structure.atoms,
                mass=np.round(dyn.structure.get_masses_array()*MASS_RY_TO_UMA, 5),
                bc=dyn.effective_charges,
                dt=dyn.dielectric_tensor)


def read_phonopy(yamlfile, bornfile=None, prefix=None):
    """Primitive cell, masses (amu), Born charges and dielectric tensor from phonopy files."""
    import phonopy

    kw = dict(produce_fc=False, log_level=0)
    if bornfile is not None:
        kw['born_filename'] = bornfile
    ph = phonopy.load(yamlfile, **kw)

    prim = ph.primitive
    if len(prim) != len(ph.unitcell):
        print('WARNING: the phonopy primitive cell ({} atoms) differs from the unit cell ({} atoms).\n'
              '         The TB file from PHONOPY2TBDAT is built in the unit cell, so it will NOT match\n'
              '         this pn.in. Re-run phonopy using the primitive cell as unit cell.'.format(len(prim), len(ph.unitcell)))

    nac = ph.nac_params
    if prefix is None:
        prefix = os.path.splitext(os.path.basename(yamlfile))[0]

    # Born charges in phonopy: born[atom][E-field][displacement], same as CellConstructor/LOTO_BC
    return dict(prefix=prefix,
                cell=np.array(prim.cell),
                positions=np.round(np.array(prim.scaled_positions), 8),
                numbers=np.array(prim.numbers),
                labels=list(prim.symbols),
                mass=np.round(np.array(prim.masses), 5),
                bc=None if nac is None else np.array(nac['born']),
                dt=None if nac is None else np.array(nac['dielectric']))


USAGE = ("Usage:\n  createSimphonyInput PathTo/name.dyn N_irr_q\n"
         "  createSimphonyInput PathTo/phonopy.yaml [BORN|-] [prefix]")

if __name__ == '__main__':

    # Handle inputs from terminal
    if len(sys.argv) < 2:
        raise SystemExit(USAGE)

    source = str(sys.argv[1])

    if source.lower().endswith(('.yaml', '.yml')):
        born = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] != '-' else None
        pref = sys.argv[3] if len(sys.argv) > 3 else None
        data = read_phonopy(source, born, pref)
    else:
        try:
            nqirrs = int(sys.argv[2])
        except IndexError:
            raise IndexError('Missing number of irreducible q points N_irr_q.\n' + USAGE)
        data = read_qe(source, nqirrs)

    prefix = data['prefix']
    bc = data['bc']
    dt = data['dt']
    isloto = "T" if (bc is not None and dt is not None) else "F"

    cell = data['cell']
    positions = data['positions']
    numbers = data['numbers']
    labels = data['labels']
    mass = data['mass']
    num_atom = len(positions)

    structure = (cell, positions, numbers)

    path = sk.get_explicit_k_path_orig_cell(structure,with_time_reversal=True, reference_distance=0.05)

    qpath = path['explicit_kpoints_rel']
    
    segments = path['explicit_segments']
    qlabels = path['explicit_kpoints_labels']
    for i in range(len(qlabels)):
        if qlabels[i]=="GAMMA":
                qlabels[i] = "G"


    with open("pn.in", "w") as f:
        f.write("!> Input file written automatically on " + str(datetime.now()) +" by F. B. \n")

        f.write("&TB_FILE\n" 
                +"Hrfile = \'{}_phononTB_hr.dat\'\n".format(prefix)
                +"/\n \n")        
        
        f.write("&CONTROL" + "\n"
                + "!> LO-TO correction (if True, long range part of Dynamical matrix must be removed from phononTB_hr.dat)"
                + "\n"
                +"LOTO_correction       = {}".format(isloto)
                + "\n"
                + "\n"    
                +"!> bulk band structure calculation flags"
                + "\n"
                +"BulkBand_calc         = F"
                + "\n"
                +"BulkGap_cube_calc     = F"
                + "\n"
                +"BulkGap_plane_calc    = F"
                + "\n"
                + "\n"
                +"!> slab band structure calculation flags"
                + "\n"
                +"SlabBand_calc         = F"
                + "\n"
                +"SlabSS_calc           = F"
                + "\n"
                +"SlabArc_calc          = F"
                + "\n"
                + "\n"
                +"!> wire band structure calculation flags"
                + "\n"
                +"WireBand_calc         = F"
                + "\n"
                + "\n"
                +"!> DOS calculation flags"
                + "\n"
                +"Dos_calc              = F"
                + "\n"
                + "\n"
                +"!> Topological quantities calculation flags"
                + "\n"
                +"FindNodes_calc        = F"
                + "\n"
                +"BerryPhase_calc       = F"
                + "\n"
                +"BerryCurvature_calc   = F"
                + "\n"
                +"Chern_3D_calc         = F"
                + "\n"
                +"Wanniercenter_calc    = F"
                + "\n"
                +"WeylChirality_calc    = F"
                + "\n"
                +"/\n \n")
        

        f.write("&SYSTEM \n"
                +"NSLAB = 10\n"
                +"NumOccupied = 1      !>Automatically selects from band 1 up to band NumOccupied. Overwriten by SELECTED_OCCUPIED_BANDS card\n"
                +"/\n"
                +"\n\n")
        
        f.write("&PARAMETERS \n"
                +"Eta_Arc = 0.005    !>infinite small value, like brodening. Too small a value leads to singularities in the Green Function \n"
                +"E_arc = 1     !>energy for calculate Fermi Arc, THz \n"
                +"OmegaNum = 100     !>omega number \n"
                +"OmegaMin =  0.5      !>energy interval in unit of THz \n"
                +"OmegaMax =  1.5     !>energy interval in unit of THz \n"
                +"Nk1 = 50           !>number k points \n"
                +"Nk2 = 50           !>number k points \n"
                +"Nk3 = 50          !>number k points \n"
                +"NP = 5             !>number of principle layers \n"
                +"Gap_threshold = 0.00001 !>threshold for GapCube output \n"
                +"/\n\n\n"
                )

        f.write("LATTICE\n"
                +"Angstrom\n"
                +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(cell[0][0],cell[0][1],cell[0][2])
                +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(cell[1][0],cell[1][1],cell[1][2])
                +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(cell[2][0],cell[2][1],cell[2][2])
                +"\n\n")
        
        f.write("ATOMS\n"
                +"{}\n".format(num_atom)
                +"Direct\n")
        for i in range(num_atom):
            f.write("{}     {}      {:20.10f}      {:20.10f}      {:20.10f}\n".format(labels[i],mass[i],positions[i][0],positions[i][1],positions[i][2]))
        f.write("\n \n")

        f.write("KPATH_BULK\n"
                +str(len(segments))+"\n")
        
        for i,s in enumerate(segments):
                i1 = s[0]
                i2 = s[1]-1
                f.write("{}   ".format(qlabels[i1]))
                f.write("{:20.8f}   ".format(np.round(qpath[i1][0],10)))
                f.write("{:20.8f}   ".format(np.round(qpath[i1][1],10)))
                f.write("{:20.8f}   ".format(np.round(qpath[i1][2],10)))
                f.write("{}   ".format(qlabels[i2]))
                f.write("{:20.8f}   ".format(np.round(qpath[i2][0],10)))
                f.write("{:20.8f}   ".format(np.round(qpath[i2][1],10)))
                f.write("{:20.8f}".format(np.round(qpath[i2][2],10)))
                f.write("\n")
        f.write("\n")                

        f.write("SELECTED_OCCUPIED_BANDS\n"
                +"1-3 !>Selects bands from 1 to 3\n" 
                +"\n\n")

        f.write("SURFACE\n"
                +"1 0 0\n"
                +"0 1 0\n" 
                +"\n\n")
        
        f.write("KPATH_SLAB\n"
                +"3\n"
                +"G 0.0 0.0 X 0.5 0.0\n"
                +"X 0.5 0.0 M 0.5 0.5\n"
                +"M 0.5 0.5 G 0.0 0.0\n"
                +"\n\n")
        
        f.write("KPLANE_SLAB\n"
                +"-0.5 -0.5\n"
                +"1.0 0.0\n"
                +"0.0 1.0\n" 
                +"\n\n")
        
        f.write("KPLANE_BULK\n"
                +"-0.00 -0.00 -0.00\n"
                +"1.00 0.00 0.00\n"
                +"0.00 1.00 0.00\n" 
                +"\n\n")
        
        f.write("KCUBE_BULK\n"
                +"-0.00 -0.00 -0.00\n"
                +"1.00 0.00 0.00\n"
                +"0.00 1.00 0.00\n" 
                +"0.00 0.00 1.00\n"
                +"\n\n")
        
        f.write("WEYL_CHIRALITY\n"
                +"2          ! Num_Weyls\n"
                +"Direct     ! Direct or Cartesian coordinate\n"
                +"0.0001       ! Radius of the ball surround a Weyl point\n"
                +"-0.50000000    0.00000000    0.00000000      ! Positions of Weyl points, No. of lines should larger than Num_weyls\n"
                +"-0.00000000    0.50000000   -0.00000000\n"
                +"\n\n")
        
        if isloto=="T":
            f.write("LOTO_DT\n"
                    +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(dt[0][0],dt[0][1],dt[0][2])
                    +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(dt[1][0],dt[1][1],dt[1][2])
                    +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(dt[2][0],dt[2][1],dt[2][2])
                    +"\n\n")
            
            f.write("LOTO_BC\n")
            for i in range(num_atom):
                f.write("{:20.10f}     {:20.10f}       {:20.10f}\n".format(bc[i][0][0],bc[i][0][1],bc[i][0][2])
                    +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(bc[i][1][0],bc[i][1][1],bc[i][1][2])
                    +"{:20.10f}     {:20.10f}       {:20.10f}\n".format(bc[i][2][0],bc[i][2][1],bc[i][2][2]))
            f.write("LOTO_INTERPOLATE\n"
                    +"11 11 11\n\n")