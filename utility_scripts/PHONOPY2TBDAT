#!/usr/bin/env python3
"""
PHONOPY2TBDAT  (prototype, companion of QE2TBDAT)

Generates 'prefix_phononTB_hr.dat' (Wannier90 hr format, units THz^2) for Simphony
from a phonopy calculation (e.g. VASP + phonopy), plus 'prefix_pn_cards.in' with the
LATTICE, ATOMS, LOTO_DT and LOTO_BC cards to paste into pn.in.

If a BORN file is given, the long-range dipole-dipole part is removed on the commensurate
q-grid with the same QE-style rgd_blk (CellConstructor/symph) that Simphony adds back when
LOTO_correction = T (default Package = 'QE' branch). Ewald length unit alat = |a1|, as in
Simphony (cell_parameters(1)).

Usage:
    PHONOPY2TBDAT phonopy.yaml [FILE ...] [-p PREFIX]

    FILE  : any of FORCE_CONSTANTS (or force_constants.hdf5), FORCE_SETS and BORN, in any
            order. Each file is identified by its content, not by its position.
            If no force-constant file is given, FORCE_SETS next to phonopy.yaml is used
            (or the forces stored in the yaml). If no BORN is given, the Born charges and
            dielectric tensor stored in the yaml are used (phonopy_params.yaml), or a BORN
            file in the current directory, exactly as phonopy and createSimphonyInput do.
    PREFIX: output prefix (default: yaml file name without extension).
    --no-nac: ignore all Born charges (no long-range subtraction; LOTO_correction = F).

    Examples:
        PHONOPY2TBDAT phonopy.yaml BORN
        PHONOPY2TBDAT phonopy.yaml FORCE_CONSTANTS BORN -p PbTe
        PHONOPY2TBDAT phonopy.yaml FORCE_CONSTANTS BORN PbTe     (old positional form)

The force constants are passed to CellConstructor in memory (Phonons.load_phonopy is NOT
used: it is disabled/buggy in every CellConstructor release up to v1.6.2).

Restrictions (CellConstructor): diagonal supercell matrix; the phonopy unit cell must be
the primitive cell (primitive_matrix = identity / 'auto' giving the same cell).

Conventions verified numerically (P1 test crystal, non-symmetric Z*):
    phonopy nac_params['born'][atom][E-field][displacement]
      == CellConstructor effective_charges[atom][E][u]
      == Simphony LOTO_BC rows (3 rows per atom, row index = E-field)
"""
import os
import sys
from datetime import datetime

import numpy as np
import phonopy
import cellconstructor as CC
import cellconstructor.Structure
import cellconstructor.Phonons
import cellconstructor.ForceTensor
import cellconstructor.symmetries
from cellconstructor.Units import MASS_RY_TO_UMA, BOHR_TO_ANGSTROM, RY_TO_EV

PWSCF_TO_THZ = 108.97077184367376   # sqrt(Ry / bohr^2 / amu) -> THz (linear frequency)

# phonopy physical units -> CellConstructor internal units (Angstrom, Ry/bohr^2)
LENGTH_TO_ANGSTROM = {"angstrom": 1.0, "au": BOHR_TO_ANGSTROM, "bohr": BOHR_TO_ANGSTROM}
FC_TO_RY_BOHR2 = {"ev/angstrom^2": BOHR_TO_ANGSTROM**2 / RY_TO_EV,
                  "ev/angstrom.au": BOHR_TO_ANGSTROM / RY_TO_EV,
                  "ev/au^2": 1.0 / RY_TO_EV,
                  "ry/au^2": 1.0,
                  "mry/au^2": 1e-3,
                  "hartree/au^2": 2.0}


def read_units(yaml):
    """physical_unit block of phonopy.yaml (phonopy defaults: angstrom, eV/angstrom^2)."""
    import yaml as pyyaml
    with open(yaml) as f:
        data = pyyaml.safe_load(f)
    units = data.get("physical_unit", {}) or {}
    length = str(units.get("length", "angstrom")).strip().lower()
    fcu = str(units.get("force_constants", "eV/angstrom^2")).strip().lower()
    if length not in LENGTH_TO_ANGSTROM or fcu not in FC_TO_RY_BOHR2:
        raise ValueError(f"Unknown phonopy units: length={length}, force_constants={fcu}")
    return LENGTH_TO_ANGSTROM[length], FC_TO_RY_BOHR2[fcu]


def read_phonopy(yaml, fc=None, born=None, fsets=None, use_nac=True):
    """Load the phonopy calculation, with full (supercell x supercell) force constants."""
    kw = dict(symmetrize_fc=False, produce_fc=True, is_compact_fc=False, log_level=0)
    if fc is not None:
        kw["force_constants_filename"] = fc
    elif fsets is not None:
        kw["force_sets_filename"] = fsets
    else:
        fsets = os.path.join(os.path.dirname(os.path.abspath(yaml)), "FORCE_SETS")
        if os.path.exists(fsets):
            kw["force_sets_filename"] = fsets
    if not use_nac:
        kw["is_nac"] = False
    elif born is not None:
        kw["born_filename"] = born
    # else: phonopy's default -> NAC parameters stored in the yaml (e.g. phonopy_params.yaml
    # from the phonon databases) or a BORN file in the current directory. This is the same
    # rule used by createSimphonyInput, so the hr.dat and the LOTO cards are consistent.
    ph = phonopy.load(yaml, **kw)

    if ph.force_constants is None:
        raise IOError("No force constants: give FORCE_CONSTANTS, or put FORCE_SETS next to the yaml.")
    if not np.allclose(ph.supercell_matrix, np.diag(np.diag(ph.supercell_matrix))):
        raise NotImplementedError("CellConstructor only supports diagonal supercell matrices.")
    if len(ph.primitive) != len(ph.unitcell):
        raise NotImplementedError("The phonopy unit cell must be the primitive cell "
                                  "(re-run phonopy with the primitive cell as input).")
    return ph


def cc_structure(cell, length_factor):
    """CellConstructor Structure (Angstrom, masses in Ry units) from a PhonopyAtoms object."""
    lat = np.array(cell.cell, dtype=float) * length_factor
    s = CC.Structure.Structure(len(cell))
    s.atoms = list(cell.symbols)
    s.unit_cell = lat
    s.has_unit_cell = True
    s.coords[:, :] = np.array(cell.scaled_positions, dtype=float) @ lat
    s.masses = {}
    for sym, m in zip(cell.symbols, cell.masses):
        if sym in s.masses and not np.isclose(s.masses[sym] * MASS_RY_TO_UMA, m):
            raise ValueError(f"Atoms labelled {sym} have different masses; relabel them.")
        s.masses[sym] = m / MASS_RY_TO_UMA
    return s


def phonopy_to_cc(ph, yaml):
    """
    Build the CellConstructor Phonons object (D(q) on the commensurate grid, Ry/bohr^2)
    directly from phonopy's full force constants. This does NOT use Phonons.load_phonopy,
    which is disabled or buggy in all CellConstructor releases up to v1.6.2.
    """
    lf, ff = read_units(yaml)
    prim = cc_structure(ph.primitive, lf)
    sup = cc_structure(ph.supercell, lf)
    nat_sc = len(ph.supercell)

    # Full FC as a (3N x 3N) matrix in Ry/bohr^2
    fc4 = np.asarray(ph.force_constants, dtype=float) * ff        # (N, N, 3, 3)
    fc = fc4.transpose(0, 2, 1, 3).reshape(3 * nat_sc, 3 * nat_sc)

    # itau: primitive atom (0-based) of each supercell atom
    p2s = list(ph.primitive.p2s_map)
    itau = np.array([p2s.index(u) for u in ph.supercell.s2u_map], dtype=np.intc)

    supercell = tuple(int(x) for x in np.diag(ph.supercell_matrix))
    q_tot = CC.symmetries.GetQGrid(prim.unit_cell, supercell)
    ig = int(np.argmin(np.sum(np.array(q_tot)**2, axis=1)))
    q_tot[ig] = q_tot[0].copy()
    q_tot[0] = np.zeros(3)

    dynq = CC.Phonons.GetDynQFromFCSupercell(fc, np.array(q_tot), prim, sup, itau)
    dyn = CC.Phonons.Phonons(prim, len(q_tot))
    dyn.q_tot = q_tot
    dyn.q_stars = [q_tot]
    dyn.dynmats = [np.array(dynq[iq]) for iq in range(len(q_tot))]
    dyn.AdjustQStar()
    return dyn


def short_range_tensor(dyn, nac):
    dyn.alat = np.linalg.norm(dyn.structure.unit_cell[0])   # Simphony: alat = |a1|
    if nac is not None:
        dyn.effective_charges = np.array(nac["born"], dtype=float)
        dyn.dielectric_tensor = np.array(nac["dielectric"], dtype=float)

    t2 = CC.ForceTensor.Tensor2(dyn.structure,
                                dyn.structure.generate_supercell(dyn.GetSupercell()),
                                dyn.GetSupercell())
    t2.verbose = False
    t2.SetupFromPhonons(dyn)   # D_SR(q) = D(q) - D_LR(q) on the grid, then to real space
    t2.Center()                # Wigner-Seitz centring (weights folded into the tensor)
    t2.Apply_ASR()
    return t2


def write_hr(t2, masses_amu, outfile):
    """
    Write the phonon TB Hamiltonian in Wannier90 *_hr.dat format (same layout as
    QE2TBDAT's write_phonon_hr2):

        H_{ia,jb}(R) = Phi^SR_{ia,jb}(R) / sqrt(M_i M_j) * (PWSCF_TO_THZ)^2   [THz^2]

    with Phi^SR in Ry/bohr^2 and M in amu. The Wigner-Seitz image weights are already
    folded into t2.tensor by Center(), so every R vector gets degeneracy 1.
    """
    rvecs = np.asarray(t2.x_r_vector2, dtype=int)          # (3, nR), crystal coordinates
    nrpt = rvecs.shape[1]
    norbs = t2.tensor.shape[1]
    m = np.repeat(np.asarray(masses_amu, dtype=float), 3)   # mass per orbital (3 per atom)
    hr = t2.tensor * PWSCF_TO_THZ**2 / np.sqrt(np.outer(m, m))[None, :, :]

    with open(outfile, "w") as f:
        f.write(f" Writen on {datetime.now()}\n")
        f.write(f"          {norbs}\n")
        f.write(f"        {nrpt}\n")
        dege = np.ones(nrpt, dtype=int)
        for n in range(int(np.ceil(nrpt / 15.0))):
            f.write("    " + "    ".join(str(d) for d in dege[n * 15:(n + 1) * 15]) + "\n")
        fmt = "{:8d}{:8d}{:8d}{:8d}{:8d}{:20.10f}{:20.10f}\n"
        for ir in range(nrpt):
            rx, ry, rz = rvecs[:, ir]
            for jo in range(norbs):          # Wannier90 order: row index runs fastest
                for io in range(norbs):
                    f.write(fmt.format(rx, ry, rz, io + 1, jo + 1, hr[ir, io, jo], 0.0))


def write_cards(ph, outfile, length_factor=1.0):
    cell = ph.primitive
    with open(outfile, "w") as f:
        f.write("LATTICE\nAngstrom\n")
        for v in np.array(cell.cell) * length_factor:
            f.write("  " + "  ".join(f"{x:16.10f}" for x in v) + "\n")
        f.write(f"\nATOMS\n{len(cell)}\nDirect\n")
        for s, m, p in zip(cell.symbols, cell.masses, cell.scaled_positions):
            f.write(f"{s:4s} {m:12.6f} " + " ".join(f"{x:14.10f}" for x in p) + "\n")
        if ph.nac_params is not None:
            f.write("\nLOTO_DT\n")
            for row in ph.nac_params["dielectric"]:
                f.write("  " + "  ".join(f"{x:14.8f}" for x in row) + "\n")
            f.write("\nLOTO_BC\n")
            for z in ph.nac_params["born"]:
                for row in z:
                    f.write("  " + "  ".join(f"{x:14.8f}" for x in row) + "\n")


def _is_number(tok, kind=float):
    try:
        kind(tok)
        return True
    except ValueError:
        return False


def classify(path):
    """Return 'fc', 'fsets' or 'born' from the content of a phonopy file."""
    if path.lower().endswith((".hdf5", ".h5")):
        return "fc"
    with open(path) as f:
        lines = [l.split() for l in (f.readline(), f.readline())]
    l1, l2 = lines
    if len(l2) == 9 and all(_is_number(t) for t in l2):
        return "born"                                   # 2nd line: epsilon (9 numbers)
    if len(l2) == 2 and all(_is_number(t, int) for t in l2):
        return "fc"                                     # '1 1' block header
    if len(l1) == 1 and len(l2) <= 1 and all(_is_number(t, int) for t in l1 + l2):
        return "fsets"                                  # type-1: natom / ndisp
    if len(l1) == 6 and all(_is_number(t) for t in l1):
        return "fsets"                                  # type-2: disp + force per line
    raise ValueError(f"Cannot tell what kind of phonopy file '{path}' is "
                     "(expected FORCE_CONSTANTS, FORCE_SETS or BORN).")


def parse_args(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(1)
    yaml = argv[1]
    files = {"fc": None, "fsets": None, "born": None}
    prefix = None
    use_nac = True
    args = argv[2:]
    k = 0
    while k < len(args):
        a = args[k]
        if a == "--no-nac":
            use_nac = False
            k += 1
            continue
        if a in ("-p", "--prefix"):
            prefix = args[k + 1]
            k += 2
            continue
        k += 1
        if a == "-":                       # placeholder of the old positional form
            continue
        if os.path.isfile(a):
            kind = classify(a)
            if files[kind] is not None:
                raise ValueError(f"Two {kind} files given: {files[kind]} and {a}")
            files[kind] = a
        elif prefix is None and k == len(args):
            prefix = a                     # old positional form: last argument = prefix
        else:
            raise FileNotFoundError(f"'{a}' is not a file (use -p PREFIX for the prefix).")
    if files["fc"] is not None and files["fsets"] is not None:
        raise ValueError("Give either FORCE_CONSTANTS or FORCE_SETS, not both.")
    if prefix is None:
        prefix = os.path.splitext(os.path.basename(yaml))[0]
    if not use_nac and files["born"] is not None:
        raise ValueError("--no-nac and a BORN file are incompatible.")
    return yaml, files, prefix, use_nac


def main(argv):
    yaml, files, prefix, use_nac = parse_args(argv)
    for kind, label in (("fc", "force constants"), ("fsets", "force sets"), ("born", "Born charges")):
        if files[kind]:
            print(f"Using {files[kind]} as {label}")
    ph = read_phonopy(yaml, files["fc"], files["born"], files["fsets"], use_nac)
    if ph.nac_params is None:
        print("No Born charges found: the long-range part is NOT removed (use LOTO_correction = F).")
    elif files["born"] is None:
        print("Using the Born charges and dielectric tensor found by phonopy (yaml or ./BORN).")
    dyn = phonopy_to_cc(ph, yaml)
    t2 = short_range_tensor(dyn, ph.nac_params)
    masses = dyn.structure.get_masses_array() * MASS_RY_TO_UMA
    if not np.allclose(masses, ph.primitive.masses, rtol=1e-6):
        raise ValueError(f"Mass mismatch CellConstructor {masses} vs phonopy {ph.primitive.masses}")

    write_hr(t2, masses, f"{prefix}_phononTB_hr.dat")
    write_cards(ph, f"{prefix}_pn_cards.in", read_units(yaml)[0])
    print(f"Written {prefix}_phononTB_hr.dat and {prefix}_pn_cards.in")
    if ph.nac_params is not None:
        print("Long-range part removed: set LOTO_correction = T in pn.in (keep Package = 'QE').")


if __name__ == "__main__":
    main(sys.argv)
